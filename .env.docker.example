# lawapp  -  Docker Compose configuration
# This is the template for the .env file used by docker-compose.yml
# Internal Docker services use service DNS (db, not localhost)

POSTGRES_HOST=db            # Docker service name  -  resolves inside Docker network
POSTGRES_PORT=5435          # Host port for external access; container internal port is 5432
POSTGRES_DB=lawapp
POSTGRES_USER=lawapp
POSTGRES_PASSWORD=CHANGE_ME_SECURE

LAWAPP_AUTH_MODE=jwt        # jwt for staging/production
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
JWT_ISSUER=lawapp-issuer
JWT_AUDIENCE=lawapp-audience

AI_PROVIDER=anthropic       # set to disabled if no key
ANTHROPIC_API_KEY=sk-ant-REAL_KEY_OR_placeholder
WORKHORSE_MODEL_ID=claude-haiku-4-5-20251001

OPENAI_API_KEY=placeholder
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

ENCRYPTION_KEY=GENERATE_WITH_FERNET
KEY_MANAGEMENT_MODE=disabled

PAYMENT_MODE=test_simulator   # change to stripe_test/stripe_live for real payments
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_PUBLIC_KEY=pk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER

ADMIN_API_KEY=CHANGE_ME
LOG_LEVEL=INFO
DEPLOYMENT_MODE=production
FCL_BULK_LICENCE_GRANTED=false
