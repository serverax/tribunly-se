# lawapp environment template — copy to .env and set real values
# DO NOT COMMIT .env (gitignored)
# See .env.local.example for local WSL dev setup
# See .env.docker.example for Docker Compose setup

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=db                        # Docker: db | Local: localhost
POSTGRES_PORT=5432                      # Docker: 5432 | Local: 5435 (avoids native PG conflict)
POSTGRES_DB=lawapp
POSTGRES_USER=lawapp
POSTGRES_PASSWORD=CHANGE_ME

# ── Auth ──────────────────────────────────────────────────────────────────────
LAWAPP_AUTH_MODE=jwt                    # none|mock|jwt
JWT_SECRET=CHANGE_ME_32_CHAR_SECRET
JWT_ISSUER=lawapp-issuer
JWT_AUDIENCE=lawapp-audience

# ── AI Provider ───────────────────────────────────────────────────────────────
# AI_PROVIDER: anthropic | disabled
# disabled = safe insufficient_grounding response (no stub answers)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-YOUR_REAL_KEY
WORKHORSE_MODEL_ID=claude-haiku-4-5-20251001

# ── Workflow C reasoning provider (OpenRouter, optional plug) ─────────────────
# OpenRouter is a REPLACEABLE provider plug used AFTER local DB+RAG+rules+de-id.
# If disabled/unset, Workflow C stays deterministic/stub and fails closed.
# Set the real rotated key only in .env (never commit). Leave blank here.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_TOKENS=1500
OPENROUTER_TEMPERATURE=0
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=lawapp

# ── Embeddings ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=placeholder             # for text-embedding-3-small; or use fastembed (no key)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Encryption ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_ME               # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_MANAGEMENT_MODE=disabled           # disabled | aws_kms

# ── Payment ───────────────────────────────────────────────────────────────────
PAYMENT_MODE=test_simulator            # test_simulator | stripe_test | stripe_live | disabled
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_PUBLIC_KEY=pk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER

# ── Admin / Security ──────────────────────────────────────────────────────────
ADMIN_API_KEY=CHANGE_ME
LOG_LEVEL=INFO
DEPLOYMENT_MODE=production
FCL_BULK_LICENCE_GRANTED=false
