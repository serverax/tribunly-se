# lawapp — Local WSL development configuration
# Copy to .env when developing locally outside Docker
# Tests use conftest.py which sets these automatically

POSTGRES_HOST=localhost
POSTGRES_PORT=5435         # 5435 avoids conflict with native Windows PG18 on 5432/5433/5434
POSTGRES_DB=lawapp
POSTGRES_USER=lawapp
POSTGRES_PASSWORD=lawapp   # matches Docker Compose DB container

LAWAPP_AUTH_MODE=mock       # mock for local dev — allows X-User-ID header
JWT_SECRET=dev-jwt-secret-replace-in-production
JWT_ISSUER=lawapp-issuer
JWT_AUDIENCE=lawapp-audience

AI_PROVIDER=disabled        # disabled until real key available
ANTHROPIC_API_KEY=placeholder
WORKHORSE_MODEL_ID=claude-haiku-4-5-20251001

OPENAI_API_KEY=placeholder
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5    # fastembed — no key required
EMBEDDING_DIM=384

ENCRYPTION_KEY=placeholder-dev-key-replace-in-production
KEY_MANAGEMENT_MODE=disabled

PAYMENT_MODE=test_simulator
STRIPE_SECRET_KEY=placeholder
STRIPE_PUBLIC_KEY=placeholder

ADMIN_API_KEY=dev-admin-key
LOG_LEVEL=DEBUG
DEPLOYMENT_MODE=development
