FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# System deps — libpq for psycopg2-binary runtime,
# libxml2/libxslt for lxml binary wheel
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libpq-dev libxml2-dev libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
       "httpx[http2]>=0.27" \
       "tenacity>=8.3" \
       "lxml>=5.2" \
       "psycopg2-binary>=2.9" \
       "pgvector>=0.3" \
       "openai>=1.35" \
       "tiktoken>=0.7" \
       "python-dotenv>=1.0" \
       "pydantic>=2.7" \
       "pydantic-settings>=2.3" \
       "rich>=13.7" \
       "pytest>=8.2" \
       "pytest-asyncio>=0.23" \
       "anthropic>=0.28" \
       "fastapi>=0.111" \
       "uvicorn[standard]>=0.30" \
       "aiofiles>=23.2" \
       "httpx>=0.27" \
       "python-multipart>=0.0.9" \
       "cryptography>=42.0" \
       "PyJWT>=2.8" \
       "boto3>=1.34" \
       "slowapi>=0.1.9" \
       "itsdangerous>=2.1" \
       "stripe>=10.0" \
       "mcp>=1.0" \
       "networkx>=3.0" \
       "fastembed>=0.3.0"

ENV FASTEMBED_CACHE_PATH=/app/fastembed_cache
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('BAAI/bge-small-en-v1.5')" \
    && echo "fastembed model pre-downloaded OK"

COPY . .
